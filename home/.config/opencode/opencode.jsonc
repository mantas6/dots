{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  "enabled_providers": [
    "anthropic",
    "openai"
  ],
  // "model": "anthropic/claude-opus-4-7",
  "plugins": [
    // https://github.com/ex-machina-co/opencode-anthropic-auth
    // v2 builds are published on the `next` npm tag, pin via `npm view @ex-machina/opencode-anthropic-auth dist-tags.next`
    "@ex-machina/opencode-anthropic-auth@2.0.0-next.5"
  ],
  // Ordered rules, last match wins. `*` also matches `/`.
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".envrc", "effect": "deny" },
    { "action": "read", "resource": "*/.envrc", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "gpg*", "effect": "deny" },
    { "action": "shell", "resource": "nix-env*", "effect": "deny" },
    { "action": "shell", "resource": "sudo*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.dots", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dots/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Downloads/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ],
  // Server settings moved out of the config in v2, use `opencode service set <hostname|port|cors> <value>`
  "mcp": {
    "servers": {
      "sentry": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "jira": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp"
      },
      "playwright": {
        "disabled": true,
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@0.0.82",
          "--headless"
        ]
      },
      "chrome-devtools": {
        "disabled": true,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.10.1"
        ]
      }
    }
  }
}
