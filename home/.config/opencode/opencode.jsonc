{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "enabled_providers": [
    "anthropic",
    "openai"
  ],
  // "model": "anthropic/claude-opus-4-7",
  "plugin": [
    // https://github.com/griffinmartin/opencode-claude-auth
    "opencode-claude-auth@v2.2.1"
    // https://github.com/ex-machina-co/opencode-anthropic-auth
    // "@ex-machina/opencode-anthropic-auth@1.8.5"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".envrc": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "gpg*": "deny",
      "nix-env*": "deny",
      "sudo*": "deny"
    },
    "external_directory": {
      "*": "deny",
      "~/.dots": "allow",
      "~/.dots/**": "allow",
      "~/Repos/*": "allow",
      "~/Repos/**": "allow",
      "~/Downloads/*": "allow",
      "~/Downloads/**": "allow",
      "/nix/store/*": "allow",
      "/nix/store/**": "allow",
      "/opt": "allow",
      "/opt/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": [
      "*"
    ]
  },
  "mcp": {
    "sentry": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "jira": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {}
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@0.0.82",
        "--headless"
      ]
    },
    "chrome-devtools": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1"
      ]
    }
  }
}
