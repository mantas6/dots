{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  // `claude-agent` runs the local Claude Code via the Agent SDK on the Claude subscription, needs `claude auth login`
  "enabled_providers": [
    "claude-agent",
    "openai"
  ],
  // "model": "claude-agent/opus",
  // Ordered rules, last match wins. `*` also matches `/`.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".envrc", "effect": "deny" },
    { "action": "read", "resource": "*/.envrc", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "shell", "resource": "gpg*", "effect": "deny" },
    { "action": "shell", "resource": "nix-env*", "effect": "deny" },
    { "action": "shell", "resource": "sudo*", "effect": "deny" },
    // A deny is final: it is checked before saved "Always" approvals and never prompts, so any folder not allowed below fails outright
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // Folders opencode itself needs. Global rules are appended after the built-in allows, so the deny above would shadow them.
    { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/shell/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/*", "effect": "allow" },
    // Built-in tmp allow on macOS ($TMPDIR is realpath'd), shadowed by the deny like the ones above
    { "action": "external_directory", "resource": "/private/var/folders/*/T/opencode/*", "effect": "allow" },
    // Skill cache and git references opencode materializes for agents to read
    { "action": "external_directory", "resource": "~/.cache/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/repos/*", "effect": "allow" },
    // T3 Code worktrees and attachments
    { "action": "external_directory", "resource": "~/.local/share/t3/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dots/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Repos/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Downloads/*", "effect": "allow" },
    // Paths are matched lexically, symlinks into the store (`which` output, profiles) are not resolved to /nix/store
    { "action": "external_directory", "resource": "/nix/store/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/run/current-system/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/etc/profiles/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.nix-profile/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" }
  ],
  // Server settings moved out of the config in v2, use `opencode service set <hostname|port|cors> <value>`
  "mcp": {
    "servers": {
      "sentry": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "jira": {
        "disabled": true,
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp"
      },
      "playwright": {
        "disabled": true,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@0.0.83",
          "--headless"
        ]
      },
      "chrome-devtools": {
        "disabled": true,
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0"
        ]
      }
    }
  }
}
