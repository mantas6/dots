{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "app.exit": "<leader>q",
    "prompt.editor": "<leader>ctrl+e",
    "input.submit": "return,ctrl+m",
    "input.delete.to.line.start": "none",
    // "session.page.up": "pageup,ctrl+b",
    // "session.page.down": "pagedown,ctrl+f",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.last": "ctrl+g,end",
    "session.first": "ctrl+o,home",
    // ctrl+o is taken by session.first, recent sessions stay reachable from the command palette
    "open.menu": "none",
    "prompt.history.previous": "ctrl+p",
    "prompt.history.next": "ctrl+n",
    "command.palette.show": "<leader>p",
    "input.delete": "delete,shift+delete"
  },
  // installed by herdr (v2 variant of the ./herdr-tui-session.js entry herdr adds to tui.jsonc)
  "plugins": [
    "./herdr-opencode"
  ],
  "session": {
    "sidebar": "hide"
  }
}
