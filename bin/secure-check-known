#!/usr/bin/env bash

status=0

while read -r line; do
    line=${line//\[/}
    line=${line//\]/}
    if [[ $line == *:* ]]; then
        # Split hostname/IP and port
        host=$(echo "$line" | awk -F: '{print $1}')
        port=$(echo "$line" | awk -F: '{print $2}')
    else
        host="$line"
        port=22
    fi

    secure-check "$host" "$port" || status=1
done < <(grep -oP '^[^, ]+' ~/.ssh/known_hosts)

exit "$status"
