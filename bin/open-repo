#!/usr/bin/env bash
# Open current repo in the browser

set -e

remote=$(git config --get remote.origin.url)

if [[ "$remote" =~ ^git@([^:]+):(.+)$ ]] || [[ "$remote" =~ ^ssh://[^@]+@([^:/]+)(:[0-9]+)?/(.+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    repo="${BASH_REMATCH[-1]}"
    host="${host#ssh.}"
    url="https://$host/${repo%.git}"
elif [[ "$remote" =~ ^https?:// ]]; then
    url="${remote%.git}"
else
    echo "Unsupported remote URL format: $remote"
    exit 1
fi

open-url "$url"
