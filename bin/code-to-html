#!/usr/bin/env sh
# Convert code file to html

set -u

for input_file in "$@"; do
    output_file="$input_file.html"

    if [ -f "$output_file" ]; then
        echo "File exists $output_file" >&2
        continue
    fi

    # Neovim expands the output path and escapes it for its Ex parser.
    # shellcheck disable=SC2016
    CODE_TO_HTML_OUTPUT="$output_file" nvim -c TOhtml \
        -c 'execute "write " . fnameescape($CODE_TO_HTML_OUTPUT)' -c qa -- "$input_file"
    add-html-title "$output_file" "$input_file"
done
