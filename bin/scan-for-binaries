#!/usr/bin/env bash
# Check for binaries files in repo changes before committing

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

found=0
while IFS= read -r -d '' entry; do
    status=${entry:0:2}
    [[ $status == *D* ]] && continue

    path=${entry:3}
    mime=$(file -E -b --mime -- "$path")
    if [[ $mime == *charset=binary* && $mime != inode/symlink* && $mime != inode/x-empty* ]]; then
        printf 'Binary file: %q\n' "$path"
        found=1
    fi
done < <(git status --porcelain=v1 -z --no-renames --untracked-files=all)

if ((found)); then
    gum log --level=error 'Binary files detected'
    exit 1
fi

gum log --level=info 'No binary files detected'
