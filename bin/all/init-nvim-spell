#!/usr/bin/env sh

set -e

name='lt.utf-8.spl'
dir="$HOME/.config/nvim/spell"

mkdir -p "$dir"
cd "$dir"

[ -f "$name" ] && exit 0

tmp=$(mktemp ".$name.XXXXXX")
cleanup() {
    status=$?
    trap - EXIT
    rm -f "$tmp"
    exit "$status"
}
trap cleanup EXIT

curl -fsSL "https://ftp.nluug.nl/pub/vim/runtime/spell/$name" -o "$tmp"
mv "$tmp" "$name"
trap - EXIT
