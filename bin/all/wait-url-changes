#!/usr/bin/env sh

url=$1

workdir=$(mktemp -d) || exit 1
trap 'rm -rf "$workdir"' 0
trap 'exit 1' HUP INT TERM

old="$workdir/old"
new="$workdir/new"

# Baseline
curl -fsS "$url" >"$old" || exit 1

while true; do
    if curl -fsS "$url" >"$new" && ! cmp -s "$old" "$new"; then
        exit 0
    fi

    sleep 1
done
