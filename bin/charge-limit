#!/usr/bin/env bash
# Set charging limit

bat0=/sys/class/power_supply/BAT0
bat1=/sys/class/power_supply/BAT1

upper=65
lower=45

set-limit() {
    echo "Setting thresholds ($lower-$upper) for $1"
    echo "$upper" >"$1/charge_stop_threshold"
    echo "$lower" >"$1/charge_start_threshold"
}

show-usage() {
    cat <<EOF
Usage: charge-limit [ACTION] [MIN-THRESHOLD?] [MAX-THRESHOLD?]

Options:
    -h, --help     print this message
    -r, --reset    reset threshold to normal values
    -w, --wide     set wide charging preset
    -s, --set      set custom charging preset, threshold need to be specified with MIN-THRESHOLD and MAX-THRESHOLD
EOF

    exit 0
}

case "$1" in
    -r | --reset)
        upper=100
        lower=0
        ;;
    -w | --wide)
        upper=80
        lower=50
        ;;
    -s | --set)
        lower=${2:-}
        upper=${3:-}
        if [[ ! $lower =~ ^(0|[1-9][0-9]?|100)$ || ! $upper =~ ^(0|[1-9][0-9]?|100)$ ]] || ((lower >= upper)); then
            printf 'charge-limit: expected 0 <= MIN-THRESHOLD < MAX-THRESHOLD <= 100\n' >&2
            exit 2
        fi
        ;;
    -h | --help) show-usage ;;
esac

[ -d "$bat0" ] && set-limit "$bat0"
[ -d "$bat1" ] && set-limit "$bat1"
