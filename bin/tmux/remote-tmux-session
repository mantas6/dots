#!/usr/bin/env bash
# Connect the current tmux session to a remote tmux session

set -e

if [[ -z ${TMUX:-} || -z ${TMUX_PANE:-} ]]; then
    printf 'remote-tmux-session must run inside tmux\n' >&2
    exit 1
fi

host=${1:-}
remote_session=${2:-}

[[ -z $host ]] && host=$(tmux show-options -qv -t "$TMUX_PANE" @remote-host)
[[ -z $remote_session ]] && remote_session=$(tmux show-options -qv -t "$TMUX_PANE" @remote-session)

if [[ -z $host || -z $remote_session ]]; then
    printf 'usage: remote-tmux-session <host> <session>\n' >&2
    exit 1
fi

if [[ ! $remote_session =~ ^[[:alnum:]_][[:alnum:]_-]*$ ]]; then
    printf 'invalid remote tmux session name: %s\n' "$remote_session" >&2
    exit 1
fi

tmux set-option -t "$TMUX_PANE" @remote-host "$host" \; \
    set-option -t "$TMUX_PANE" @remote-session "$remote_session" \; \
    set-option -t "$TMUX_PANE" prefix None \; \
    set-option -t "$TMUX_PANE" prefix2 C-b \; \
    set-option -t "$TMUX_PANE" status off \; \
    set-option -t "$TMUX_PANE" mouse off

exec ssh -t -- "$host" "exec tmux new-session -A -s $remote_session"
