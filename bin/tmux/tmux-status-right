#!/usr/bin/env sh

set -e

export GIT_OPTIONAL_LOCKS=0

changes=false
unpushed=false

if [ "$(git status --short)" != '' ]; then
    changes=true
fi

if git status | grep -q 'Your branch is ahead of'; then
    unpushed=true
fi

status=$(tmux-bg status "$1") || status=''
branch=$(git branch --show-current 2>/dev/null)

if $changes; then
    status="$status#[fg=pink]*#[default]"
fi

if $unpushed; then
    status="$status#[fg=yellow]^#[default]"
fi

printf '%s' "$status$branch"
