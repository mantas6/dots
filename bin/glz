#!/usr/bin/env bash

set -e

repo=$(basename "$(pwd)")
state="$HOME/.local/state/dots/glz/$repo"
mkdir -p "$state"

branch=$(git branch --show-current)
msg_file="$state/${branch//\//_}"

add=true

last_msg=$branch
[ -f "$msg_file" ] && last_msg=$(<"$msg_file")

while getopts 'i' opt; do
    case ${opt} in
        ?)
            exit 1
            ;;
    esac
done

if [ -z "$(git status --porcelain)" ]; then
    exit 0
fi

show_staged() {
    echo
    git diff --staged
    git status --short --branch
    echo
}

shown=false

if $add && ! git diff --cached --quiet; then
    if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
        show_staged
        read -rp 'Commit only staged changes? [Y/n] ' reply
        [[ $reply =~ ^[Nn] ]] && exit 0
        add=false
        shown=true
    fi
fi

$add && git add .
$shown || show_staged

msg=$(gum write --show-line-numbers --height=5 --placeholder 'Commit message' --value="$last_msg")

echo "$msg"

printf '%s' "$msg" >"$msg_file"
git commit -m "$msg"

if git ls-remote --exit-code --heads origin "$(git branch --show-current)" >/dev/null 2>&1; then
    git pull --no-edit
fi

git push
